@startuml C4-Context-Task4
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title C4 — System Context: распределение актуальных ставок депозитов в кол-центры (банк «Стандарт»)

Person(op_cc,        "Оператор кол-центра банка", "Консультирует клиентов по депозитам")
Person(op_pcc,       "Оператор партнёрского кол-центра", "Внешний персонал; не имеет доступа к системам банка")
Person(dep_mgr,      "Менеджер БО депозитов", "Публикует обновлённые ставки")

System(bank,         "Банк «Стандарт» — система ставок и их распределения", "Хранение и публикация ставок депозитов; распределение в кол-центр банка (online API) и партнёрский кол-центр (файлы по SFTP)")

System_Ext(pccs,     "Система партнёрского кол-центра", "Внешняя система; ставки получает в виде CSV-файла с SFTP-сервера банка по расписанию")

Rel(dep_mgr, bank,   "Веб-UI Rates Service: ввод и публикация ставок")
Rel(op_cc, bank,     "Веб-UI системы кол-центра банка: просмотр ставок (REST → Rates Service)")
Rel(bank, pccs,      "CSV-файл актуальных ставок (SFTP, pull партнёром по расписанию)")
Rel(pccs, op_pcc,    "Отображение ставок в интерфейсе партнёрской системы")

@enduml
