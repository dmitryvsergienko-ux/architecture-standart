<mxfile host="app.diagrams.net" agent="generator" version="22.0.0" type="device"><diagram id="task4-roadmap" name="Roadmap"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Roadmap: интеграция ставок депозитов в кол-центр банка и партнёрский кол-центр (на базе MVP Task 3)" style="rounded=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2160" height="50" as="geometry"/></mxCell><mxCell id="q2_hdr" value="Q2 — MVP (горизонт 6 мес.)" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;align=center;rounded=0;whiteSpace=wrap;html=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="60" width="600" height="50" as="geometry"/></mxCell><mxCell id="q3_hdr" value="Q3 — пост-MVP" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;align=center;rounded=0;whiteSpace=wrap;html=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="600" height="50" as="geometry"/></mxCell><mxCell id="q4_hdr" value="Q4 — целевое решение (1 год)" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;align=center;rounded=0;whiteSpace=wrap;html=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1380" y="60" width="600" height="50" as="geometry"/></mxCell><mxCell id="lane0_bg" value="" style="shape=rect;fillColor=#fff2cc;strokeColor=none;rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="130" width="1800" height="110" as="geometry"/></mxCell><mxCell id="lane0_lbl" value="Rates Service" style="rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontSize=13;fontStyle=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="130" width="180" height="110" as="geometry"/></mxCell><mxCell id="lane1_bg" value="" style="shape=rect;fillColor=#fce4d6;strokeColor=none;rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="240" width="1800" height="110" as="geometry"/></mxCell><mxCell id="lane1_lbl" value="SFTP Export Service&#10;(новый)" style="rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontSize=13;fontStyle=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="180" height="110" as="geometry"/></mxCell><mxCell id="lane2_bg" value="" style="shape=rect;fillColor=#fff2cc;strokeColor=none;rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="350" width="1800" height="110" as="geometry"/></mxCell><mxCell id="lane2_lbl" value="SFTP Server&#10;(новый, в DMZ)" style="rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontSize=13;fontStyle=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="350" width="180" height="110" as="geometry"/></mxCell><mxCell id="lane3_bg" value="" style="shape=rect;fillColor=#fce4d6;strokeColor=none;rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="460" width="1800" height="110" as="geometry"/></mxCell><mxCell id="lane3_lbl" value="Система&#10;кол-центра банка" style="rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontSize=13;fontStyle=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="460" width="180" height="110" as="geometry"/></mxCell><mxCell id="lane4_bg" value="" style="shape=rect;fillColor=#fff2cc;strokeColor=none;rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="570" width="1800" height="110" as="geometry"/></mxCell><mxCell id="lane4_lbl" value="Система&#10;партнёрского кол-центра&#10;(внешняя)" style="rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontSize=13;fontStyle=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="570" width="180" height="110" as="geometry"/></mxCell><mxCell id="lane5_bg" value="" style="shape=rect;fillColor=#fce4d6;strokeColor=none;rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="680" width="1800" height="110" as="geometry"/></mxCell><mxCell id="lane5_lbl" value="Мониторинг" style="rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontSize=13;fontStyle=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="680" width="180" height="110" as="geometry"/></mxCell><mxCell id="T1" value="T1 — REST endpoint /api/v1/rates/public для системы КЦ банка" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="200" y="160" width="220" height="50" as="geometry"/></mxCell><mxCell id="T2" value="T2 — Полный snapshot в событии rates.updated" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="440" y="160" width="220" height="50" as="geometry"/></mxCell><mxCell id="T3" value="T3 — Разработка сервиса (Kafka consumer + CSV gen + SFTP uploader)" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="280" y="270" width="320" height="50" as="geometry"/></mxCell><mxCell id="T4" value="T4 — Ретраи, алерты" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="620" y="270" width="140" height="50" as="geometry"/></mxCell><mxCell id="T5" value="T5 — Провижининг SFTP в DMZ&#10;(оба ЦОД)" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="200" y="380" width="200" height="50" as="geometry"/></mxCell><mxCell id="T6" value="T6 — SSH-ключи, chroot, RBAC" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="420" y="380" width="200" height="50" as="geometry"/></mxCell><mxCell id="T7" value="T7 — UI «Депозитные ставки»&#10;(доработка подрядчиком)" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="280" y="490" width="280" height="50" as="geometry"/></mxCell><mxCell id="T8" value="T8 — REST-интеграция,&#10;локальный кэш TTL 1 ч" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="490" width="180" height="50" as="geometry"/></mxCell><mxCell id="T9" value="T9 — Партнёр настраивает pull CSV&#10;с SFTP, парсинг, отображение" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="460" y="600" width="300" height="50" as="geometry"/></mxCell><mxCell id="T10" value="T10 — Дашборды SFTP,&#10;алерт «нет выгрузки &gt; 30 мин»" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="540" y="710" width="220" height="50" as="geometry"/></mxCell><mxCell id="T11" value="T11 — Расширение API ставок:&#10;версионирование, доступ для других внешних потребителей" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="380" height="50" as="geometry"/></mxCell><mxCell id="T12" value="T12 — Полноценный APM&#10;(Prometheus + Grafana + ELK для всего пайплайна)" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="800" y="710" width="380" height="50" as="geometry"/></mxCell><mxCell id="T13" value="T13 — Политика ротации SSH-ключей партнёра&#10;(каждые 6 мес.); аудит доступа к SFTP" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="800" y="380" width="380" height="50" as="geometry"/></mxCell><mxCell id="T14" value="T14 — Целевое (12 мес.): автоматическое согласование заявок депозитов без участия БО" style="shape=rect;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1400" y="160" width="380" height="50" as="geometry"/></mxCell><mxCell id="T15" value="T15 — Если у партнёра появится возможность API:&#10;миграция с SFTP на REST через API Gateway" style="shape=rect;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1400" y="600" width="380" height="50" as="geometry"/></mxCell><mxCell id="T16" value="T16 — Персонализированные ставки в КЦ банка&#10;(integration с Customer Profile)" style="shape=rect;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1400" y="490" width="380" height="50" as="geometry"/></mxCell><mxCell id="legend" value="Условные обозначения&#10;&#10;• Оранжевый прямоугольник — задача в скоупе MVP (Q2) или пост-MVP стабилизации (Q3).&#10;• Голубой прямоугольник — задача целевого состояния (Q4, горизонт 1 год; не входит в MVP, но обязана быть на дорожной карте).&#10;• Цветные полосы — lanes систем (чередование цветов — для читаемости); левая колонка — название системы.&#10;• Step-метки сверху — границы кварталов; шкала Q2 ≈ 1 мес. = 100 px (ориентировочно).&#10;&#10;Зависимости (не отрисованы стрелками для упрощения, но фактические):&#10;  T1, T2 → блокируют T3 (нужен API и формат события)&#10;  T5, T6 → блокируют T3 (SFTP-сервер должен быть готов до интеграции)&#10;  T1 → блокирует T8 (REST-интеграция требует API)&#10;  T7 → предшествует T8 (UI готов до интеграции)&#10;  T3, T4, T6 → блокируют T9 (партнёр интегрируется к готовому SFTP)" style="rounded=0;fillColor=#F8F8F8;strokeColor=#1F4E79;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="800" width="1980" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>