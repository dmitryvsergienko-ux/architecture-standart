" value="IT-отдел" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1455" y="782" width="180" height="60" as="geometry"/></mxCell><mxCell id="it_note" value="Поддерживает IT-системы банка:&#10;АБС, ИБ, СМС-шлюз, Систему кол-центра банка, Сайт.&#10;(в т.ч. совм. с подрядчиками: ИБ, Система кол-центра)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1340" y="830" width="420" height="90" as="geometry"/></mxCell><mxCell id="e_cl_site" value="HTTPS&#10;(маркетинг)" style="endArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="a_client" target="site"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_cl_ib" value="HTTPS&#10;(платежи, тек. счёт)" style="endArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="a_client" target="ib"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_cl_branch" value="визит в отделение" style="endArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="a_client" target="a_branch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_opcc_ccs" value="веб-UI&#10;(заведение обращения)" style="endArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="a_op_cc" target="ccs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_oppcc_pccs" value="веб-UI" style="endArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="a_op_pcc" target="pccs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_ib_abs" value="прямой доступ к БД Oracle&#10;(shared DB)" style="endArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="ib" target="abs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_ccs_abs" value="запись обращения в БД АБС&#10;(прямой DB-write)" style="endArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="ccs" target="abs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_br_abs" value="Delphi-клиент&#10;(создание депозита,&#10;загрузка документов)" style="endArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="a_branch" target="abs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_dep_abs" value="АБС&#10;(обработка заявок,&#10;проставление ставки)" style="endArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="a_dep" target="abs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_cr_abs" value="АБС&#10;(раздел кред. риска)" style="endArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="a_cred" target="abs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_br_dep" value="Email&#10;(запрос/ответ ставки)" style="endArrow=classic;startArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="a_branch" target="a_dep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_dep_cr" value="Email&#10;(риск-метрики)" style="endArrow=classic;startArrow=classic;html=1;rounded=0;fontSize=9;" edge="1" parent="1" source="a_dep" target="a_cred"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_abs_sms" value="HTTP/SOAP&#10;(автом. СМС&#10;после проставления ставки)" style="endArrow=classic;html=1;rounded=0;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="abs" target="sms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_sms_tel" value="SMPP / HTTPS" style="endArrow=classic;html=1;rounded=0;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sms" target="telecom"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Условные обозначения&#10;&#10;Узлы:&#10;• голубой прямоугольник — IT-система банка (внутренняя или развёрнутая в инфраструктуре банка);&#10;• сиреневый пунктирный прямоугольник — внешняя система;&#10;• стикмен — актор (роль человека-участника процесса).&#10;&#10;Стрелки:&#10;• сплошная — направленная интеграция (HTTP/SOAP/DB) или взаимодействие актора с системой;&#10;• двунаправленная — двусторонний обмен между акторами (Email)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F8F8;strokeColor=#1F4E79;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="1200" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>